---
/**
 * Head block per SEO_SPEC §§1-4: unique title/meta, self-referencing canonical
 * (trailing slash, absolute), hreflang, OG/Twitter cards, JSON-LD.
 * hreflang: de-CH + x-default point at the German page; fr-CH/en entries are
 * added per page once those locales ship (SEO_SPEC §2).
 */
import { absoluteUrl, BRAND, SITE_URL } from '../lib/site';
import { LOCALE_LANG, LOCALE_OG, type Alternate, type Locale } from '../lib/locales';

interface Props {
  title: string;
  description: string;
  /** Canonical path with trailing slash, e.g. "/impressum/". */
  path: string;
  /** Extra JSON-LD blocks for this page (BreadcrumbList comes from <Breadcrumbs/>). */
  jsonLd?: object[];
  ogImage?: string;
  locale?: Locale;
  /** hreflang alternates for translated pages; omit for single-locale pages. */
  alternates?: Alternate[];
}

const { title, description, path, jsonLd = [], ogImage = '/og-default.png', locale = 'de', alternates } = Astro.props;
if (!path.endsWith('/')) throw new Error(`SEO path must end with a trailing slash (SEO_SPEC §1): ${path}`);
if (title.length > 65) throw new Error(`Title too long (${title.length} > 65): ${title}`);

const canonical = absoluteUrl(path);
// Single-locale pages keep self-referencing hreflang; paired pages emit the set.
const hreflangs: Alternate[] = alternates ?? [
  { hreflang: LOCALE_LANG[locale], href: canonical },
  { hreflang: 'x-default', href: canonical },
];

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE_URL}/#organization`,
  name: BRAND,
  url: `${SITE_URL}/`,
  logo: absoluteUrl('/favicon.svg'),
};

const blocks = [organization, ...jsonLd];
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{hreflangs.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={BRAND} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={absoluteUrl(ogImage)} />
<meta property="og:locale" content={LOCALE_OG[locale]} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteUrl(ogImage)} />

{blocks.map((block) => <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />)}
