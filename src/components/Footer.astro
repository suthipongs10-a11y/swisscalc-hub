---
import { useTranslations } from '../lib/i18n';
import { BRAND } from '../lib/site';
import type { Locale } from '../lib/locales';

interface Props {
  locale?: Locale;
}
const { locale = 'de' } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();

// Locale-specific legal/trust links for the non-German footer.
const legal =
  locale === 'fr'
    ? {
        label: 'Informations légales',
        methodology: '/fr/methodologie/',
        about: '/fr/a-propos/',
        imprint: '/fr/mentions-legales/',
        privacy: '/fr/protection-des-donnees/',
        sources: '/fr/sources/',
      }
    : {
        label: 'Legal information',
        methodology: '/en/methodology/',
        about: '/en/about/',
        imprint: '/en/legal-notice/',
        privacy: '/en/privacy/',
        sources: '/en/sources/',
      };
---

<footer class="mt-16 border-t border-slate-200 bg-slate-50">
  <div class="mx-auto max-w-4xl px-4 py-8 text-sm text-slate-600">
    <p class="mb-4 max-w-xl">{t('footer.tagline')}</p>
    {
      locale === 'de' ? (
        <nav aria-label="Rechtliches">
          <ul class="mb-4 flex flex-wrap gap-x-5 gap-y-1">
            <li><a href="/ratgeber/" class="hover:text-slate-900 hover:underline">{t('nav.guide')}</a></li>
            <li><a href="/methodik/" class="hover:text-slate-900 hover:underline">{t('nav.methodology')}</a></li>
            <li><a href="/ueber-uns/" class="hover:text-slate-900 hover:underline">{t('nav.about')}</a></li>
            <li><a href="/impressum/" class="hover:text-slate-900 hover:underline">{t('footer.imprint')}</a></li>
            <li><a href="/datenschutz/" class="hover:text-slate-900 hover:underline">{t('footer.privacy')}</a></li>
            <li><a href="/quellen/" class="hover:text-slate-900 hover:underline">{t('footer.sources')}</a></li>
          </ul>
        </nav>
      ) : (
        <nav aria-label={legal.label}>
          <ul class="mb-4 flex flex-wrap gap-x-5 gap-y-1">
            <li><a href={legal.methodology} class="hover:text-slate-900 hover:underline">{t('nav.methodology')}</a></li>
            <li><a href={legal.about} class="hover:text-slate-900 hover:underline">{t('nav.about')}</a></li>
            <li><a href={legal.imprint} class="hover:text-slate-900 hover:underline">{t('footer.imprint')}</a></li>
            <li><a href={legal.privacy} class="hover:text-slate-900 hover:underline">{t('footer.privacy')}</a></li>
            <li><a href={legal.sources} class="hover:text-slate-900 hover:underline">{t('footer.sources')}</a></li>
          </ul>
        </nav>
      )
    }
    <p class="mb-2 text-xs text-slate-500">{t('footer.disclaimer')}</p>
    <p class="text-xs text-slate-500">© {year} {BRAND}</p>
  </div>
</footer>
