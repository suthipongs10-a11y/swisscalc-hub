---
import { useTranslations } from '../lib/i18n';
import { BRAND } from '../lib/site';
import { TOOLS } from '../lib/tools';
import { counterpartOf, OTHER_LOCALES, type Locale } from '../lib/locales';

interface Props {
  locale?: Locale;
  path?: string;
}
const { locale = 'de', path = '/' } = Astro.props;
const t = useTranslations(locale);

// German nav (live German tools + guide + methodik).
const liveTools = TOOLS.filter((tool) => tool.href !== null);
const shortNames: Record<string, string> = {
  'brutto-netto-rechner': 'Brutto-Netto',
  'quellensteuer-rechner': 'Quellensteuer',
  'steuervergleich': 'Steuervergleich',
  'saeule-3a-rechner': 'Säule 3a',
  'franchise-rechner': 'Franchise',
};

// French / English nav (the three shipped tools per locale).
const frTools = [
  { href: '/fr/calculateur-salaire-brut-net/', short: 'Salaire net', full: 'Calculateur salaire brut-net' },
  { href: '/fr/comparatif-impots-cantons/', short: 'Comparatif impôts', full: 'Comparatif des impôts cantonaux' },
  { href: '/fr/calculateur-3e-pilier/', short: '3e pilier', full: 'Calculateur 3e pilier' },
];
const enTools = [
  { href: '/en/salary-calculator/', short: 'Salary', full: 'Salary calculator' },
  { href: '/en/cantonal-tax-comparison/', short: 'Tax comparison', full: 'Cantonal tax comparison' },
  { href: '/en/pillar-3a-calculator/', short: 'Pillar 3a', full: 'Pillar 3a calculator' },
];
const nonDeTools = locale === 'fr' ? frTools : enTools;
const methodologyHref = locale === 'fr' ? '/fr/methodologie/' : '/en/methodology/';
const aboutHref = locale === 'fr' ? '/fr/a-propos/' : '/en/about/';
const navLabel = locale === 'fr' ? 'Navigation principale' : 'Main navigation';

// Language switcher: one chip per other locale that has a counterpart page
// (keeps single-locale pages free of dead toggles).
const switchers = OTHER_LOCALES[locale]
  .map((loc) => ({ loc, href: counterpartOf(path, loc) }))
  .filter((s): s is { loc: Locale; href: string } => Boolean(s.href));
const langName: Record<Locale, string> = { de: 'Deutsch', fr: 'Français', en: 'English' };
---

<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex max-w-4xl items-center justify-between px-4 py-3">
    <a href={locale === 'de' ? '/' : `/${locale}/`} class="flex items-center gap-2 text-lg font-bold text-slate-900" aria-label={BRAND}>
      <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
        <rect width="24" height="24" rx="5" fill="#0f4c81"></rect>
        <rect x="6" y="7" width="12" height="2.5" rx="1.25" fill="#fff"></rect>
        <rect x="6" y="12" width="12" height="2.5" rx="1.25" fill="#fff"></rect>
        <rect x="6" y="17" width="7" height="2.5" rx="1.25" fill="#7fb3d5"></rect>
      </svg>
      {BRAND}
    </a>

    <!-- Desktop navigation -->
    {
      locale === 'de' ? (
        <nav aria-label="Hauptnavigation" class="hidden md:block">
          <ul class="flex items-center gap-5 text-sm text-slate-600">
            {liveTools.map((tool) => (
              <li>
                <a href={tool.href} class="hover:text-slate-900 hover:underline">
                  {shortNames[tool.id] ?? tool.name}
                </a>
              </li>
            ))}
            <li><a href="/ratgeber/" class="hover:text-slate-900 hover:underline">{t('nav.guide')}</a></li>
            <li><a href="/methodik/" class="hover:text-slate-900 hover:underline">{t('nav.methodology')}</a></li>
            {switchers.map((s) => (
              <li>
                <a href={s.href} rel="alternate" hreflang={s.loc} class="rounded border border-slate-300 px-2 py-1 text-xs font-medium hover:bg-slate-100">
                  {s.loc.toUpperCase()}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ) : (
        <nav aria-label={navLabel} class="hidden md:block">
          <ul class="flex items-center gap-5 text-sm text-slate-600">
            {nonDeTools.map((tool) => (
              <li>
                <a href={tool.href} class="hover:text-slate-900 hover:underline">
                  {tool.short}
                </a>
              </li>
            ))}
            <li><a href={methodologyHref} class="hover:text-slate-900 hover:underline">{t('nav.methodology')}</a></li>
            {switchers.map((s) => (
              <li>
                <a href={s.href} rel="alternate" hreflang={s.loc} class="rounded border border-slate-300 px-2 py-1 text-xs font-medium hover:bg-slate-100">
                  {s.loc.toUpperCase()}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <!-- Mobile menu: <details> disclosure — works without JavaScript -->
    <details class="group relative md:hidden">
      <summary
        class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-md text-slate-700 hover:bg-slate-100 [&::-webkit-details-marker]:hidden"
        aria-label={t('nav.menu')}
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="block group-open:hidden">
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="18" x2="20" y2="18"></line>
        </svg>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="hidden group-open:block">
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="18" y1="6" x2="6" y2="18"></line>
        </svg>
      </summary>

      <nav aria-label="Mobile Navigation" class="absolute right-0 top-full z-50 mt-2 w-64 rounded-lg border border-slate-200 bg-white p-2 shadow-lg">
        <p class="px-3 pb-1 pt-2 text-xs font-semibold uppercase tracking-wide text-slate-400">{t('nav.allTools')}</p>
        <ul>
          {
            locale === 'de'
              ? liveTools.map((tool) => (
                  <li>
                    <a href={tool.href} class="block rounded-md px-3 py-2.5 text-sm text-slate-700 hover:bg-slate-50">
                      {tool.name}
                    </a>
                  </li>
                ))
              : nonDeTools.map((tool) => (
                  <li>
                    <a href={tool.href} class="block rounded-md px-3 py-2.5 text-sm text-slate-700 hover:bg-slate-50">
                      {tool.full}
                    </a>
                  </li>
                ))
          }
        </ul>
        {
          locale === 'de' && (
            <>
              <div class="my-1 border-t border-slate-100" role="presentation" />
              <ul>
                <li><a href="/ratgeber/" class="block rounded-md px-3 py-2.5 text-sm text-slate-700 hover:bg-slate-50">{t('nav.guide')}</a></li>
                <li><a href="/methodik/" class="block rounded-md px-3 py-2.5 text-sm text-slate-700 hover:bg-slate-50">{t('nav.methodology')}</a></li>
                <li><a href="/ueber-uns/" class="block rounded-md px-3 py-2.5 text-sm text-slate-700 hover:bg-slate-50">{t('nav.about')}</a></li>
              </ul>
            </>
          )
        }
        {
          locale !== 'de' && (
            <>
              <div class="my-1 border-t border-slate-100" role="presentation" />
              <ul>
                <li><a href={methodologyHref} class="block rounded-md px-3 py-2.5 text-sm text-slate-700 hover:bg-slate-50">{t('nav.methodology')}</a></li>
                <li><a href={aboutHref} class="block rounded-md px-3 py-2.5 text-sm text-slate-700 hover:bg-slate-50">{t('nav.about')}</a></li>
              </ul>
            </>
          )
        }
        {
          switchers.length > 0 && (
            <>
              <div class="my-1 border-t border-slate-100" role="presentation" />
              {switchers.map((s) => (
                <a href={s.href} rel="alternate" hreflang={s.loc} class="block rounded-md px-3 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50">
                  {langName[s.loc]}
                </a>
              ))}
            </>
          )
        }
      </nav>
    </details>
  </div>
</header>
