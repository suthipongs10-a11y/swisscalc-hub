---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import QstCalculator from '../../components/QstCalculator.astro';
import { BRAND, SITE_URL, SITE_YEAR, absoluteUrl } from '../../lib/site';
import qstIndex from '../../data/qst/index.json';
import cantonData from '../../data/cantons.json';
import { enName, enSlugOf } from '../../lib/tax/labels';

const cantonsByName = [...cantonData.cantons].sort((a, b) => enName(a.abbr).localeCompare(enName(b.abbr)));

const path = '/en/withholding-tax-calculator/';
const title = `Withholding tax calculator ${SITE_YEAR} | ${BRAND}`;
const description = `Calculate Swiss withholding tax (Quellensteuer) ${SITE_YEAR} for all 26 cantons: by canton, tariff code (A/B/C/H), children and church tax — with the official FTA tariffs.`;
const cantonCount = qstIndex.cantons.length;

const faqs = [
  {
    q: 'Who pays withholding tax in Switzerland?',
    a: 'Foreign employees without a C settlement permit (typically a B, L or G permit). Anyone holding a C permit or married to a Swiss national is assessed under the ordinary procedure and pays no withholding tax.',
  },
  {
    q: 'What do the tariff codes A, B, C and H mean?',
    a: 'A = single, B = married with one income (single earner), C = married with two incomes (dual earners), H = single person with children in their own household. Added to these are the number of children and church-tax status (Y = with, N = without).',
  },
  {
    q: 'Is withholding tax calculated monthly?',
    a: `Yes — the official tariffs are based on the monthly gross salary. This calculator uses the cantonal FTA tariffs ${SITE_YEAR} for all ${cantonCount} cantons. With irregular salaries or a 13th month, the effective annual figure can differ slightly depending on the cantonal model (monthly or annual).`,
  },
  {
    q: 'Can I reclaim overpaid withholding tax?',
    a: 'Yes. Until 31 March of the following year, you can request a subsequent ordinary assessment or a tariff correction to claim deductions (pillar 3a, further training, childcare). From CHF 120,000 gross annual salary you are, in most cantons, assessed under the ordinary procedure anyway.',
  },
];

const webApp = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Withholding tax calculator',
  url: absoluteUrl(path),
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  inLanguage: 'en-CH',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'CHF' },
  publisher: { '@id': `${SITE_URL}/#organization` },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout title={title} description={description} path={path} locale="en" jsonLd={[webApp, faqSchema]}>
  <Breadcrumbs crumbs={[{ name: 'Withholding tax calculator' }]} locale="en" />

  <h1 class="mb-2 text-3xl font-bold tracking-tight sm:text-4xl">Withholding tax calculator {SITE_YEAR}</h1>
  <p class="mb-8 max-w-2xl text-lg text-slate-700">
    Calculate Swiss withholding tax (Quellensteuer) for all {cantonCount} cantons — by canton, tariff code, number of
    children and church tax, with the official FTA tariffs {SITE_YEAR}.
  </p>

  <QstCalculator locale="en" />

  <div class="prose-content mt-14 max-w-2xl">
    <h2>How is withholding tax calculated?</h2>
    <p>
      Withholding tax is deducted directly from the monthly gross salary. Decisive are the canton of residence, the
      tariff code (your family situation) and the gross salary. Each canton publishes its own tariff tables, which
      already include cantonal, municipal and federal tax as well as flat-rate deductions. This calculator evaluates the
      official FTA tariff files {SITE_YEAR}.
    </p>
    <h3>Limits of this calculation</h3>
    <ul>
      <li>Covered are tariff codes <strong>A, B, C and H</strong> with 0–5 children and church tax (where the canton levies it at source). Special cases (cross-border tariffs, board members, replacement income) are not reproduced.</li>
      <li>The tariffs are based on the <strong>monthly salary</strong>. A 13th month, bonuses and the cantonal monthly-vs-annual model can affect the effective annual figure.</li>
      <li>Rates are grouped to 0.05 points for an indicative calculation — the binding statement is produced by your employer under the cantonal tariffs.</li>
    </ul>

    <h2>Frequently asked questions</h2>
    {faqs.map((f) => (
      <div class="mb-4">
        <h3 class="mb-1 text-lg font-semibold text-slate-900">{f.q}</h3>
        <p class="text-slate-700">{f.a}</p>
      </div>
    ))}

    <p>
      Detailed guide for expats: <a href="/en/guide/withholding-tax-for-expats/">withholding tax in Switzerland</a>.
    </p>
  </div>

  <section aria-label="Withholding tax by canton" class="mt-14">
    <h2 class="mb-4 text-2xl font-bold">Withholding tax by canton</h2>
    <ul class="grid grid-cols-2 gap-x-6 gap-y-1 text-sm sm:grid-cols-3">
      {cantonsByName.map((c) => (
        <li>
          <a href={`/en/withholding-tax-calculator/${enSlugOf(c.abbr)}/`} class="text-blue-700 hover:underline">{enName(c.abbr)}</a>
        </li>
      ))}
    </ul>
  </section>

  <section aria-label="Other calculators" class="mt-14">
    <h2 class="mb-4 text-2xl font-bold">Other calculators</h2>
    <ul class="grid gap-4 sm:grid-cols-2">
      <li class="rounded-lg border border-slate-200 p-5">
        <a href="/en/salary-calculator/" class="font-semibold text-blue-700 hover:underline">Swiss salary calculator</a>
        <p class="mt-1 text-sm leading-relaxed text-slate-600">Social-security contributions on the gross salary.</p>
      </li>
      <li class="rounded-lg border border-slate-200 p-5">
        <a href="/en/cantonal-tax-comparison/" class="font-semibold text-blue-700 hover:underline">Cantonal tax comparison (26 cantons)</a>
        <p class="mt-1 text-sm leading-relaxed text-slate-600">Where do you pay the least tax?</p>
      </li>
    </ul>
  </section>

  <div class="mt-10 max-w-2xl border-t border-slate-200 pt-4 text-sm text-slate-500">
    <p class="mb-1">
      <strong>Sources:</strong> {SITE_YEAR} cantonal withholding-tax tariffs:
      <a class="underline" href="https://www.estv.admin.ch/estv/en/home/direct-federal-tax/withholding-tax.html" rel="noopener">FTA / cantonal tax administrations</a>.
      The tariff content is the cantons' responsibility. Methodology: <a class="underline" href="/en/methodology/">methodology</a>.
    </p>
    <p>Last updated: 13.07.2026 · {SITE_YEAR} data</p>
  </div>
</BaseLayout>
