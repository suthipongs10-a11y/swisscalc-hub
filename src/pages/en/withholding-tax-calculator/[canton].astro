---
import { readFileSync } from 'node:fs';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import QstCantonCalculator from '../../../components/QstCantonCalculator.astro';
import cantonData from '../../../data/cantons.json';
import qstIndex from '../../../data/qst/index.json';
import { BRAND, SITE_URL, SITE_YEAR, absoluteUrl } from '../../../lib/site';
import { formatCHF, formatPercent } from '../../../lib/format';
import { enName, enSlugOf } from '../../../lib/tax/labels';
import { CANTON_QST_CONTENT_EN } from '../../../lib/cantonQstContentEn';
import { CANTON_QST_PRACTICE_EN } from '../../../lib/cantonQstPracticeEn';
import { isAnnualModel } from '../../../lib/qst/cantons';
import { qstForCode, buildCode, resolveChurch, type QstData, type ChurchMode } from '../../../lib/qst/engine';
import { compareQst } from '../../../lib/qst/compare';
import { loadQstvFile } from '../../../lib/qst/compareData';

export function getStaticPaths() {
  return cantonData.cantons.map((c) => ({ params: { canton: enSlugOf(c.abbr)! }, props: { canton: c } }));
}
interface CantonInfo { bfs: number; abbr: string; name: string; slug: string }
const { canton } = Astro.props as { canton: CantonInfo };
const { abbr } = canton;

const editorial = CANTON_QST_CONTENT_EN[abbr];
if (!editorial) throw new Error(`Missing EN QST editorial for ${abbr}`);
const practice = CANTON_QST_PRACTICE_EN[abbr];
if (!practice) throw new Error(`Missing EN QST practice for ${abbr}`);
const name = enName(abbr);
const meta = qstIndex.cantons.find((c) => c.abbr === abbr)!;
const data = JSON.parse(readFileSync(`public/data/qst/${abbr.toLowerCase()}.json`, 'utf8')) as QstData;

const model = isAnnualModel(abbr) ? 'annual model' : 'monthly model';
const churchText =
  meta.church === 'both' ? 'with and without church tax' : meta.church === 'Y' ? 'only with church tax' : 'without church tax (not levied at source in the canton)';

const church = resolveChurch(meta.church as ChurchMode, false);
const code = buildCode('A', 0, church);
const examples = [6000, 8000, 10000].map((m) => ({ m, r: qstForCode(m, data, code) }));

const REF = 8000;
const situations: { label: string; code: string }[] = [
  { label: 'Single, no children', code: buildCode('A', 0, church) },
  { label: 'Married, single earner, no children', code: buildCode('B', 0, church) },
  { label: 'Married, single earner, two children', code: buildCode('B', 2, church) },
  { label: 'Married, dual earners, no children', code: buildCode('C', 0, church) },
  { label: 'Married, dual earners, two children', code: buildCode('C', 2, church) },
  { label: 'Single parent, one child', code: buildCode('H', 1, church) },
];
const codeRows = situations
  .map((s) => ({ ...s, r: qstForCode(REF, data, s.code) }))
  .filter((s) => s.r.monthlyTax > 0);
const codeSpread =
  codeRows.length > 1 ? codeRows[0]!.r.monthlyTax - codeRows[codeRows.length - 1]!.r.monthlyTax : 0;

const ladder = [4000, 6000, 8000, 12000, 16000].map((m) => ({ m, r: qstForCode(m, data, code) }));
const ladderFirst = ladder[0]!;
const ladderLast = ladder[ladder.length - 1]!;

const rows = compareQst(REF, false, loadQstvFile('a0'));
const rank = rows.findIndex((r) => r.abbr === abbr) + 1;
const self = rows[rank - 1]!;
const cheapest = rows[0]!;
const dearest = rows[rows.length - 1]!;
const vsCheapest = self.monthlyTax - cheapest.monthlyTax;
const vsDearest = dearest.monthlyTax - self.monthlyTax;

const path = `/en/withholding-tax-calculator/${enSlugOf(abbr)}/`;
const title = `Withholding tax ${name} ${SITE_YEAR} | ${BRAND}`;
const description = `Calculate withholding tax in the canton of ${name} ${SITE_YEAR}: by tariff code (A/B/C/H), children and church tax. ${model}, official FTA tariffs. Example: ${formatCHF(examples[1].r.monthlyTax, 0)}/month at ${formatCHF(8000, 0)} (single).`;

const faqs = [
  {
    q: `Under which model is withholding tax calculated in the canton of ${name}?`,
    a: `The canton of ${name} calculates under the ${model}. The tariffs include cantonal, municipal and federal tax and are published ${churchText}. The gross salary is decisive; for your salary, use the calculator above.`,
  },
  {
    q: `How high is withholding tax in ${name} at ${formatCHF(8000, 0)} per month?`,
    a: `A single person without children pays in ${name}, at ${formatCHF(8000, 0)} gross monthly salary, about ${formatCHF(examples[1].r.monthlyTax, 0)} withholding tax (${formatPercent(examples[1].r.ratePct / 100)} effective). With children, married or with church tax the rate shifts — the calculator above shows your case.`,
  },
  editorial.faq,
  practice.faq,
];

const webApp = {
  '@context': 'https://schema.org', '@type': 'WebApplication', name: `Withholding tax calculator canton of ${name}`,
  url: absoluteUrl(path), applicationCategory: 'FinanceApplication', operatingSystem: 'Web', inLanguage: 'en-CH',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'CHF' }, publisher: { '@id': `${SITE_URL}/#organization` },
};
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout title={title} description={description} path={path} locale="en" heroLabel={abbr} jsonLd={[webApp, faqSchema]}>
  <Breadcrumbs crumbs={[{ name: 'Withholding tax calculator', path: '/en/withholding-tax-calculator/' }, { name: `Canton of ${name}` }]} locale="en" />

  <h1 class="mb-2 text-3xl font-bold tracking-tight sm:text-4xl">Withholding tax canton of {name} {SITE_YEAR}</h1>
  <p class="mb-8 max-w-2xl text-lg text-slate-700">
    Calculate withholding tax in the canton of {name} — by tariff code, number of children and church tax, with the
    official FTA tariffs {SITE_YEAR}.
  </p>

  <QstCantonCalculator abbr={abbr} locale="en" />

  <div class="prose-content mt-14 max-w-2xl">
    <h2>Withholding tax in the canton of {name}</h2>
    <p>{editorial.intro}</p>

    <h3>Key facts {SITE_YEAR}</h3>
    <table class="w-full text-sm">
      <tbody>
        <tr class="border-b border-slate-100"><td class="py-2 pr-2">Calculation model</td><td class="py-2 pl-2 text-right">{model}</td></tr>
        <tr class="border-b border-slate-100"><td class="py-2 pr-2">Church tax</td><td class="py-2 pl-2 text-right">{churchText}</td></tr>
        <tr class="border-b border-slate-100"><td class="py-2 pr-2">Tariff codes</td><td class="py-2 pl-2 text-right">A, B, C, H</td></tr>
        {examples.map((e) => (
          <tr class="border-b border-slate-100">
            <td class="py-2 pr-2">Example: {formatCHF(e.m, 0)}/month (single)</td>
            <td class="py-2 pl-2 text-right tabular-nums">{formatCHF(e.r.monthlyTax, 0)} ({formatPercent(e.r.ratePct / 100)})</td>
          </tr>
        ))}
      </tbody>
    </table>

    <h2>Withholding tax in {name} in practice</h2>
    <p>{practice.practice}</p>

    <h2>What the tariff code changes in {name}</h2>
    <p>
      {formatCHF(REF, 0)} gross salary per month in the canton of {name}, six family situations — under the
      {' '}{abbr} tariff {SITE_YEAR}:
    </p>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-slate-200 text-left">
          <th class="py-2 pr-2 font-semibold">Situation</th>
          <th class="py-2 pl-2 text-right font-semibold">Code</th>
          <th class="py-2 pl-2 text-right font-semibold">Withholding tax</th>
        </tr>
      </thead>
      <tbody>
        {codeRows.map((s) => (
          <tr class="border-b border-slate-100">
            <td class="py-2 pr-2">{s.label}</td>
            <td class="py-2 pl-2 text-right tabular-nums">{s.code}</td>
            <td class="py-2 pl-2 text-right tabular-nums">{formatCHF(s.r.monthlyTax)}</td>
          </tr>
        ))}
      </tbody>
    </table>
    {codeSpread > 0 && (
      <p>
        Spread in {name}: <strong>{formatCHF(codeSpread, 0)} per month</strong> at an identical salary —
        {' '}{formatCHF(codeSpread * 12, 0)} over a year. Check the code on your
        {' '}<a href="/en/guide/understanding-swiss-payslip/">payslip</a>.
      </p>
    )}

    <h2>How the rate climbs with the salary</h2>
    <p>Single, no children, tariff {code}, canton of {name}:</p>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-slate-200 text-left">
          <th class="py-2 pr-2 font-semibold">Gross salary / month</th>
          <th class="py-2 pl-2 text-right font-semibold">Rate</th>
          <th class="py-2 pl-2 text-right font-semibold">Withholding tax</th>
        </tr>
      </thead>
      <tbody>
        {ladder.map((e) => (
          <tr class="border-b border-slate-100">
            <td class="py-2 pr-2 tabular-nums">{formatCHF(e.m, 0)}</td>
            <td class="py-2 pl-2 text-right tabular-nums">{formatPercent(e.r.ratePct / 100)}</td>
            <td class="py-2 pl-2 text-right tabular-nums">{formatCHF(e.r.monthlyTax)}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p>
      The salary quadruples; withholding tax in {name} rises from {formatCHF(ladderFirst.r.monthlyTax, 0)} to
      {' '}{formatCHF(ladderLast.r.monthlyTax, 0)} — the rate from {formatPercent(ladderFirst.r.ratePct / 100)} to
      {' '}{formatPercent(ladderLast.r.ratePct / 100)}.
    </p>

    <h2>{name} against the other cantons</h2>
    <p>
      At {formatCHF(REF, 0)} gross per month (single, no children, no church tax), {name} sits at
      {' '}<strong>rank {rank} of {rows.length}</strong>, counting from the cheapest canton to the most expensive.
    </p>
    <ul>
      <li>
        Cheapest canton: <a href={`/en/withholding-tax-calculator/${enSlugOf(cheapest.abbr)}/`}>{enName(cheapest.abbr)}</a>
        {' '}at {formatCHF(cheapest.monthlyTax)} per month
        {rank === 1 ? ' — that is this canton.' : ` (${formatCHF(vsCheapest, 0)} less than in ${name})`}
      </li>
      <li>
        Most expensive canton: <a href={`/en/withholding-tax-calculator/${enSlugOf(dearest.abbr)}/`}>{enName(dearest.abbr)}</a>
        {' '}at {formatCHF(dearest.monthlyTax)} per month
        {rank === rows.length ? ' — that is this canton.' : ` (${formatCHF(vsDearest, 0)} more than in ${name})`}
      </li>
      <li>
        {name}: {formatCHF(self.monthlyTax)} per month, or {formatCHF(self.annualTax, 0)} a year.
      </li>
    </ul>
    <p>
      Every canton side by side: <a href="/en/withholding-tax-comparison/">withholding tax comparison</a>. Paid too
      much? A tariff correction or subsequent ordinary assessment with the {name} tax administration runs until 31 March
      of the following year — the guide
      <a href="/en/guide/withholding-or-ordinary-assessment/">withholding tax or ordinary assessment</a> explains how.
    </p>

    <h2>Frequently asked questions</h2>
    {faqs.map((f) => (
      <div class="mb-4">
        <h3 class="mb-1 text-lg font-semibold text-slate-900">{f.q}</h3>
        <p class="text-slate-700">{f.a}</p>
      </div>
    ))}

    <p>
      Ordinary income tax in the canton of {name}: <a href={`/en/tax-calculator/${enSlugOf(abbr)}/`}>tax calculator {name}</a>.
      Social-security contributions on the salary: <a href="/en/salary-calculator/">salary calculator</a>. All cantons:
      <a href="/en/withholding-tax-calculator/">withholding tax calculator</a>.
    </p>
  </div>

  <div class="mt-10 max-w-2xl border-t border-slate-200 pt-4 text-sm text-slate-500">
    <p class="mb-1">
      <strong>Sources:</strong> {SITE_YEAR} withholding-tax tariffs:
      <a class="underline" href="https://www.estv.admin.ch/estv/en/home/direct-federal-tax/withholding-tax.html" rel="noopener">FTA / tax administration of the canton of {name}</a>.
      The tariff content is the canton's responsibility. Methodology: <a class="underline" href="/en/methodology/">methodology</a>.
    </p>
    <p>Last updated: 13.07.2026 · {SITE_YEAR} data</p>
  </div>
</BaseLayout>
