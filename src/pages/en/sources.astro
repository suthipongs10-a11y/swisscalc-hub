---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { BRAND } from '../../lib/site';
import { DATASETS, QST_CANTON_COUNT, formatRetrieved } from '../../lib/dataRegistry';

const institutions = [
  {
    name: 'Federal Tax Administration (FTA) — tax calculator and tax data',
    url: 'https://swisstaxcalculator.estv.admin.ch/',
    use: 'Schedules, multipliers and deductions of the Confederation, cantons and municipalities',
  },
  {
    name: 'Federal Statistical Office (FSO) — official register of municipalities',
    url: 'https://www.bfs.admin.ch/bfs/en/home/basics/swiss-official-commune-register.html',
    use: 'FSO municipality numbers as the location key',
  },
  {
    name: 'Federal Office of Public Health (FOPH) — health-insurance premiums',
    url: 'https://opendata.swiss/en/dataset/health-insurance-premiums',
    use: 'Approved compulsory (KVG/LAMal) premiums by insurer, premium region, age group and franchise',
  },
  {
    name: 'Federal Social Insurance Office (FSIO)',
    url: 'https://www.bsv.admin.ch/bsv/en/home.html',
    use: 'AHV/IV/EO/ALV contribution rates, occupational-pension key figures and pillar 3a maximum amounts',
  },
  {
    name: 'devbrains — swisstaxcalculator (MIT licence)',
    url: 'https://github.com/devbrains-com/swisstaxcalculator',
    use: 'Open-source reference implementation of the tax calculation based on FTA data; validation reference for our calculation logic',
  },
];

const LABELS: Record<string, { name: string; feeds: string }> = {
  social: {
    name: 'Social-insurance contributions (AHV/IV/EO, ALV, NBU, BVG)',
    feeds: 'Salary calculator, hourly wage calculator',
  },
  saeule3a: { name: 'Pillar 3a maximum amounts', feeds: 'Pillar 3a calculator' },
  hourly: { name: 'Payroll constants (vacation compensation, 13th month salary)', feeds: 'Hourly wage calculator' },
  federal: { name: 'Direct federal tax tariffs', feeds: 'Tax comparison, canton pages, pillar 3a calculator' },
  cantonal: {
    name: 'Cantonal income-tax tariffs (base tax, 26 cantons)',
    feeds: 'Tax comparison, canton pages, pillar 3a calculator',
  },
  multipliers: {
    name: 'Tax multipliers of cantons and capitals',
    feeds: 'Tax comparison, canton pages',
  },
  stats: {
    name: 'Municipal multipliers: range per canton (all municipalities)',
    feeds: 'Canton pages (cheapest/most expensive municipality)',
  },
  qst: {
    name: `Withholding tax tariffs (${QST_CANTON_COUNT} cantons, codes A/B/C/H)`,
    feeds: 'Withholding tax calculator, comparison, canton pages',
  },
};
---

<BaseLayout
  title={`Sources and data | ${BRAND}`}
  description="Every dataset behind the CalcSwiss calculators with its official source, retrieval date and tax year — FTA, FSO, FOPH and FSIO, individually traceable."
  path="/en/sources/"
  locale="en"
>
  <Breadcrumbs crumbs={[{ name: 'Sources' }]} locale="en" />
  <article class="prose-content max-w-3xl">
    <h1 class="mb-6 text-3xl font-bold">Sources and data</h1>
    <p>
      No figure on calcswiss.ch is without an origin: every calculation parameter lives in a versioned data file that
      documents its own official source, retrieval date and tax year. The table below is generated directly from those
      data files — so it shows exactly the data the calculators on this site actually compute with.
    </p>

    <h2>Datasets in use</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-slate-200 text-left">
            <th class="py-2 pr-2 font-semibold">Dataset</th>
            <th class="py-2 px-2 font-semibold">Used by</th>
            <th class="py-2 px-2 text-right font-semibold">Year</th>
            <th class="py-2 pl-2 text-right font-semibold">Retrieved</th>
          </tr>
        </thead>
        <tbody>
          {DATASETS.map((d) => (
            <tr class="border-b border-slate-100 align-top">
              <td class="py-2 pr-2">
                <a href={d.source} rel="noopener">{LABELS[d.id]!.name}</a>
              </td>
              <td class="py-2 px-2 text-slate-600">{LABELS[d.id]!.feeds}</td>
              <td class="py-2 px-2 text-right tabular-nums">{d.year}</td>
              <td class="py-2 pl-2 text-right tabular-nums">{formatRetrieved(d.retrieved)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="text-sm text-slate-600">
      Each dataset name links to the official publication. The FTA tax data was obtained via the MIT-licensed reference
      implementation
      <a href="https://github.com/devbrains-com/swisstaxcalculator" rel="noopener">devbrains/swisstaxcalculator</a>,
      which builds on the same official dataset.
    </p>

    <h2>Publishing institutions</h2>
    <ul>
      {
        institutions.map((source) => (
          <li>
            <a href={source.url} rel="noopener">
              {source.name}
            </a>
            <br />
            <span class="text-sm text-slate-600">{source.use}</span>
          </li>
        ))
      }
    </ul>

    <h2>How we update the data</h2>
    <p>
      The calculators call <strong>no external APIs</strong> at runtime. All parameters are bundled at build time from
      the versioned data files; updates happen as traceable data refreshes with a new retrieval date. When an authority
      changes a value — the pillar 3a maximum amounts, say, or the multipliers of a new tax year — the affected file is
      renewed and the date in the table above moves with it. Every calculator page additionally states its data
      snapshot in the footer.
    </p>
    <p>
      The calculation logic itself is covered by automated tests against published official example values; how we
      calculate is documented on the <a href="/en/methodology/">methodology</a> page.
    </p>
    <p>
      All calculations are indicative; the official assessment is binding. The FTA, FSO, FOPH and FSIO are not
      affiliated with this website.
    </p>
  </article>
</BaseLayout>
