---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import QstCompare from '../../components/QstCompare.astro';
import { BRAND, SITE_URL, SITE_YEAR, absoluteUrl } from '../../lib/site';

const path = '/en/withholding-tax-comparison/';
const title = `Swiss withholding tax comparison ${SITE_YEAR} | ${BRAND}`;
const description = `Withholding tax across all 26 Swiss cantons ${SITE_YEAR}: one gross salary, every canton — ranked cheapest to most expensive, with the official FTA tariffs.`;

const faqs = [
  {
    q: 'Why does withholding tax differ so much between cantons?',
    a: 'The withholding tariffs bundle the cantonal, municipal and federal tax of each canton. Since cantonal tax rates vary widely, the withholding tax on the same salary differs considerably — the comparison shows the full range at a glance.',
  },
  {
    q: 'Can I lower my withholding tax by moving?',
    a: 'Yes — what generally counts is your canton of residence (for cross-border commuters, the canton of work). Moving to a cheaper canton lowers your withholding tax accordingly. But factor in rents and health-insurance premiums, which can eat up the tax advantage.',
  },
  {
    q: 'What does the asterisk (annual model) in the table mean?',
    a: 'Fribourg, Geneva, Ticino, Vaud and Valais use the annual model: the salary is annualised and smoothed to determine the rate. With a steady monthly salary the result is comparable to the monthly model; with bonuses or irregular pay the effective annual settlement can differ.',
  },
  {
    q: 'Does the comparison apply to cross-border commuters?',
    a: 'Only partially. Commuters from Germany pay a reduced rate of at most 4.5% (tax treaty); eight cantons have a special agreement with France, and separate tariffs exist for Italy. The comparison shows the ordinary A/B/C/H tariffs for people resident in Switzerland.',
  },
];

const webApp = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Swiss withholding tax comparison',
  url: absoluteUrl(path),
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  inLanguage: 'en-CH',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'CHF' },
  publisher: { '@id': `${SITE_URL}/#organization` },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout title={title} description={description} path={path} locale="en" hero="comparison" jsonLd={[webApp, faqSchema]}>
  <Breadcrumbs
    crumbs={[{ name: 'Withholding tax', path: '/en/withholding-tax-calculator/' }, { name: 'Cantonal comparison' }]}
    locale="en"
  />

  <h1 class="mb-2 text-3xl font-bold tracking-tight sm:text-4xl">Swiss withholding tax comparison {SITE_YEAR}</h1>
  <p class="mb-8 max-w-2xl text-lg text-slate-700">
    One gross salary, all 26 cantons: see at a glance where withholding tax is lowest and where it is highest — with
    the official FTA tariffs {SITE_YEAR}.
  </p>

  <QstCompare locale="en" />

  <div class="prose-content mt-14 max-w-2xl">
    <h2>How does the comparison work?</h2>
    <p>
      For every canton, the same monthly gross salary is run through the canton's official {SITE_YEAR} tariff table —
      using the tariff code that matches your situation (A/B/C/H, number of children, church tax). The table ranks the
      cantons from cheapest to most expensive. Clicking a canton opens its withholding-tax page with details and its
      own calculator.
    </p>
    <h3>Limits of this calculation</h3>
    <ul>
      <li>In Geneva, Neuchâtel, Ticino, Vaud and Valais, church tax is <strong>not levied at source</strong>; in Jura it is always included. The church-tax option therefore only affects the remaining cantons.</li>
      <li>Five cantons use the <strong>annual model</strong> (asterisk in the table) — with irregular salaries the effective annual settlement can differ from the monthly figure.</li>
      <li>Special cases (cross-border tariffs DE/FR/IT, secondary employment, replacement income) are not covered; rates are merged to 0.05 percentage points (indicative calculation).</li>
    </ul>

    <h2>Frequently asked questions</h2>
    {faqs.map((f) => (
      <div class="mb-4">
        <h3 class="mb-1 text-lg font-semibold text-slate-900">{f.q}</h3>
        <p class="text-slate-700">{f.a}</p>
      </div>
    ))}

    <p>
      Details per canton: <a href="/en/withholding-tax-calculator/">withholding tax calculator</a>. Ordinarily taxed?
      <a href="/en/cantonal-tax-comparison/">cantonal tax comparison</a>. From gross to net:
      <a href="/en/salary-calculator/">salary calculator</a>.
    </p>
  </div>

  <section aria-label="Other calculators" class="mt-14">
    <h2 class="mb-4 text-2xl font-bold">Other calculators</h2>
    <ul class="grid gap-4 sm:grid-cols-2">
      <li class="rounded-lg border border-slate-200 p-5">
        <a href="/en/withholding-tax-calculator/" class="font-semibold text-blue-700 hover:underline">Withholding tax calculator</a>
        <p class="mt-1 text-sm leading-relaxed text-slate-600">By canton, tariff code and family situation.</p>
      </li>
      <li class="rounded-lg border border-slate-200 p-5">
        <a href="/en/cantonal-tax-comparison/" class="font-semibold text-blue-700 hover:underline">Cantonal tax comparison</a>
        <p class="mt-1 text-sm leading-relaxed text-slate-600">For ordinarily taxed residents.</p>
      </li>
    </ul>
  </section>

  <div class="mt-10 max-w-2xl border-t border-slate-200 pt-4 text-sm text-slate-500">
    <p class="mb-1">
      <strong>Sources:</strong> cantonal withholding-tax tariffs {SITE_YEAR}:
      <a class="underline" href="https://www.estv.admin.ch/estv/en/home/direct-federal-tax/withholding-tax.html" rel="noopener">FTA / cantonal tax administrations</a>.
      The cantons are responsible for the tariff content. Method and limits:
      <a class="underline" href="/en/methodology/">methodology</a>.
    </p>
    <p>Last updated: 15.07.2026 · {SITE_YEAR} tax-year data</p>
  </div>
</BaseLayout>
