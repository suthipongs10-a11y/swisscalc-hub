---
/**
 * Programmatic per-canton Quellensteuer pages (SEO_SPEC §3.2): individually
 * written intro + FAQ per canton (src/lib/cantonQstContent.ts), quantitative
 * blocks computed from that canton's tariff data.
 */
import { readFileSync } from 'node:fs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import QstCantonCalculator from '../../components/QstCantonCalculator.astro';
import cantonData from '../../data/cantons.json';
import qstIndex from '../../data/qst/index.json';
import { BRAND, SITE_URL, SITE_YEAR, absoluteUrl } from '../../lib/site';
import { formatCHF, formatPercent } from '../../lib/format';
import { deName, cantonSlugOf } from '../../lib/tax/labels';
import { CANTON_QST_CONTENT } from '../../lib/cantonQstContent';
import { CANTON_QST_PRACTICE } from '../../lib/cantonQstPractice';
import { isAnnualModel } from '../../lib/qst/cantons';
import { qstForCode, buildCode, resolveChurch, type QstData, type ChurchMode } from '../../lib/qst/engine';
import { compareQst } from '../../lib/qst/compare';
import { loadQstvFile } from '../../lib/qst/compareData';

export function getStaticPaths() {
  return cantonData.cantons.map((c) => ({ params: { kanton: c.slug }, props: { canton: c } }));
}
interface CantonInfo { bfs: number; abbr: string; name: string; slug: string }
const { canton } = Astro.props as { canton: CantonInfo };
const { abbr } = canton;

const editorial = CANTON_QST_CONTENT[abbr];
if (!editorial) throw new Error(`Missing QST editorial for ${abbr}`);
const practice = CANTON_QST_PRACTICE[abbr];
if (!practice) throw new Error(`Missing QST practice editorial for ${abbr}`);
const name = deName(abbr);
const meta = qstIndex.cantons.find((c) => c.abbr === abbr)!;
const data = JSON.parse(readFileSync(`public/data/qst/${abbr.toLowerCase()}.json`, 'utf8')) as QstData;

const model = isAnnualModel(abbr) ? 'Jahresmodell' : 'Monatsmodell';
const churchText =
  meta.church === 'both' ? 'mit und ohne Kirchensteuer' : meta.church === 'Y' ? 'nur mit Kirchensteuer' : 'ohne Kirchensteuer (im Kanton nicht an der Quelle erhoben)';

// Example: single person, no children, income levels — from this canton's tariff.
const church = resolveChurch(meta.church as ChurchMode, false);
const code = buildCode('A', 0, church);
const examples = [6000, 8000, 10000].map((m) => ({ m, r: qstForCode(m, data, code) }));

/* --- What the tariff code does to the deduction, at one reference salary --- */
const REF = 8000;
const situations: { label: string; code: string }[] = [
  { label: 'Alleinstehend, ohne Kinder', code: buildCode('A', 0, church) },
  { label: 'Verheiratet, ein Erwerbseinkommen, ohne Kinder', code: buildCode('B', 0, church) },
  { label: 'Verheiratet, ein Erwerbseinkommen, zwei Kinder', code: buildCode('B', 2, church) },
  { label: 'Verheiratet, beide erwerbstätig, ohne Kinder', code: buildCode('C', 0, church) },
  { label: 'Verheiratet, beide erwerbstätig, zwei Kinder', code: buildCode('C', 2, church) },
  { label: 'Alleinerziehend, ein Kind', code: buildCode('H', 1, church) },
];
const codeRows = situations
  .map((s) => ({ ...s, r: qstForCode(REF, data, s.code) }))
  .filter((s) => s.r.monthlyTax > 0);
const codeSpread =
  codeRows.length > 1 ? codeRows[0]!.r.monthlyTax - codeRows[codeRows.length - 1]!.r.monthlyTax : 0;

/* --- How the rate climbs with the salary, in this canton --- */
const ladder = [4000, 6000, 8000, 12000, 16000].map((m) => ({ m, r: qstForCode(m, data, code) }));
const ladderFirst = ladder[0]!;
const ladderLast = ladder[ladder.length - 1]!;

/* --- Where this canton sits nationally, same situation and salary --- */
const rows = compareQst(REF, false, loadQstvFile('a0'));
const rank = rows.findIndex((r) => r.abbr === abbr) + 1;
const self = rows[rank - 1]!;
const cheapest = rows[0]!;
const dearest = rows[rows.length - 1]!;
const vsCheapest = self.monthlyTax - cheapest.monthlyTax;
const vsDearest = dearest.monthlyTax - self.monthlyTax;

const path = `/quellensteuer-rechner/${canton.slug}/`;
const title = `Quellensteuer ${name} ${SITE_YEAR} berechnen | ${BRAND}`;
const description = `Quellensteuer im Kanton ${name} ${SITE_YEAR} berechnen: nach Tarifcode (A/B/C/H), Kindern und Kirchensteuer. ${model}, offizielle ESTV-Tarife. Beispiel: ${formatCHF(examples[1].r.monthlyTax, 0)}/Monat bei ${formatCHF(8000, 0)} (alleinstehend).`;

const faqs = [
  {
    q: `Nach welchem Modell wird die Quellensteuer im Kanton ${name} berechnet?`,
    a: `Der Kanton ${name} rechnet nach dem ${model}. Die Tarife enthalten Kantons-, Gemeinde- und Bundessteuer und werden ${churchText} geführt. Massgebend ist der Bruttolohn; für Ihren Lohn nutzen Sie den Rechner oben.`,
  },
  {
    q: `Wie hoch ist die Quellensteuer in ${name} bei ${formatCHF(8000, 0)} pro Monat?`,
    a: `Eine alleinstehende Person ohne Kinder zahlt in ${name} bei ${formatCHF(8000, 0)} Bruttolohn pro Monat rund ${formatCHF(examples[1].r.monthlyTax, 0)} Quellensteuer (${formatPercent(examples[1].r.ratePct / 100)} effektiv). Mit Kindern, verheiratet oder mit Kirchensteuer verschiebt sich der Satz — der Rechner oben zeigt Ihren Fall.`,
  },
  editorial.faq,
  practice.faq,
];

const webApp = {
  '@context': 'https://schema.org', '@type': 'WebApplication', name: `Quellensteuer-Rechner Kanton ${name}`,
  url: absoluteUrl(path), applicationCategory: 'FinanceApplication', operatingSystem: 'Web', inLanguage: 'de-CH',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'CHF' }, publisher: { '@id': `${SITE_URL}/#organization` },
};
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const incomeTaxSlug = cantonSlugOf(abbr);
---

<BaseLayout title={title} description={description} path={path} heroLabel={abbr} jsonLd={[webApp, faqSchema]}>
  <Breadcrumbs crumbs={[{ name: 'Quellensteuer-Rechner', path: '/quellensteuer-rechner/' }, { name: `Kanton ${name}` }]} />

  <h1 class="mb-2 text-3xl font-bold tracking-tight sm:text-4xl">Quellensteuer Kanton {name} {SITE_YEAR}</h1>
  <p class="mb-8 max-w-2xl text-lg text-slate-700">
    Berechnen Sie die Quellensteuer im Kanton {name} — nach Tarifcode, Anzahl Kindern und Kirchensteuer, mit den
    offiziellen ESTV-Tarifen {SITE_YEAR}.
  </p>

  <QstCantonCalculator abbr={abbr} locale="de" />

  <div class="prose-content mt-14 max-w-2xl">
    <h2>Quellensteuer im Kanton {name}</h2>
    <p>{editorial.intro}</p>

    <h3>Die wichtigsten Fakten {SITE_YEAR}</h3>
    <table class="w-full text-sm">
      <tbody>
        <tr class="border-b border-slate-100"><td class="py-2 pr-2">Berechnungsmodell</td><td class="py-2 pl-2 text-right">{model}</td></tr>
        <tr class="border-b border-slate-100"><td class="py-2 pr-2">Kirchensteuer</td><td class="py-2 pl-2 text-right">{churchText}</td></tr>
        <tr class="border-b border-slate-100"><td class="py-2 pr-2">Tarifcodes</td><td class="py-2 pl-2 text-right">A, B, C, H</td></tr>
        {examples.map((e) => (
          <tr class="border-b border-slate-100">
            <td class="py-2 pr-2">Beispiel: {formatCHF(e.m, 0)}/Monat (alleinstehend)</td>
            <td class="py-2 pl-2 text-right tabular-nums">{formatCHF(e.r.monthlyTax, 0)} ({formatPercent(e.r.ratePct / 100)})</td>
          </tr>
        ))}
      </tbody>
    </table>

    <h2>Quellensteuer in {name} in der Praxis</h2>
    <p>{practice.practice}</p>

    <h2>Was der Tarifcode in {name} ausmacht</h2>
    <p>
      {formatCHF(REF, 0)} Bruttolohn pro Monat im Kanton {name}, sechs Familiensituationen — nach dem
      {' '}{abbr}-Tarif {SITE_YEAR}:
    </p>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-slate-200 text-left">
          <th class="py-2 pr-2 font-semibold">Situation</th>
          <th class="py-2 pl-2 text-right font-semibold">Code</th>
          <th class="py-2 pl-2 text-right font-semibold">Quellensteuer</th>
        </tr>
      </thead>
      <tbody>
        {codeRows.map((s) => (
          <tr class="border-b border-slate-100">
            <td class="py-2 pr-2">{s.label}</td>
            <td class="py-2 pl-2 text-right tabular-nums">{s.code}</td>
            <td class="py-2 pl-2 text-right tabular-nums">{formatCHF(s.r.monthlyTax)}</td>
          </tr>
        ))}
      </tbody>
    </table>
    {codeSpread > 0 && (
      <p>
        Spannweite in {name}: <strong>{formatCHF(codeSpread, 0)} pro Monat</strong> bei identischem Lohn, über ein Jahr
        {' '}{formatCHF(codeSpread * 12, 0)}. Prüfen Sie den Code auf Ihrer
        {' '}<a href="/ratgeber/lohnabrechnung-verstehen/">Lohnabrechnung</a>.
      </p>
    )}

    <h2>Wie der Satz mit dem Lohn steigt</h2>
    <p>Alleinstehend ohne Kinder, Tarif {code}, Kanton {name}:</p>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-slate-200 text-left">
          <th class="py-2 pr-2 font-semibold">Bruttolohn / Monat</th>
          <th class="py-2 pl-2 text-right font-semibold">Satz</th>
          <th class="py-2 pl-2 text-right font-semibold">Quellensteuer</th>
        </tr>
      </thead>
      <tbody>
        {ladder.map((e) => (
          <tr class="border-b border-slate-100">
            <td class="py-2 pr-2 tabular-nums">{formatCHF(e.m, 0)}</td>
            <td class="py-2 pl-2 text-right tabular-nums">{formatPercent(e.r.ratePct / 100)}</td>
            <td class="py-2 pl-2 text-right tabular-nums">{formatCHF(e.r.monthlyTax)}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p>
      Der Lohn vervierfacht sich, die Quellensteuer in {name} steigt von
      {' '}{formatCHF(ladderFirst.r.monthlyTax, 0)} auf {formatCHF(ladderLast.r.monthlyTax, 0)} — der Satz von
      {' '}{formatPercent(ladderFirst.r.ratePct / 100)} auf {formatPercent(ladderLast.r.ratePct / 100)}.
    </p>

    <h2>{name} im Vergleich mit den anderen Kantonen</h2>
    <p>
      Bei {formatCHF(REF, 0)} Bruttolohn pro Monat (alleinstehend, ohne Kinder, ohne Kirchensteuer) liegt
      {' '}{name} auf <strong>Rang {rank} von {rows.length}</strong> — von der günstigsten zur teuersten Quellensteuer
      gezählt.
    </p>
    <ul>
      <li>
        Günstigster Kanton: <a href={`/quellensteuer-rechner/${cantonSlugOf(cheapest.abbr)}/`}>{deName(cheapest.abbr)}</a>
        {' '}mit {formatCHF(cheapest.monthlyTax)} pro Monat
        {rank === 1 ? ' — das ist dieser Kanton.' : ` (${formatCHF(vsCheapest, 0)} weniger als in ${name})`}
      </li>
      <li>
        Teuerster Kanton: <a href={`/quellensteuer-rechner/${cantonSlugOf(dearest.abbr)}/`}>{deName(dearest.abbr)}</a>
        {' '}mit {formatCHF(dearest.monthlyTax)} pro Monat
        {rank === rows.length ? ' — das ist dieser Kanton.' : ` (${formatCHF(vsDearest, 0)} mehr als in ${name})`}
      </li>
      <li>
        {name}: {formatCHF(self.monthlyTax)} pro Monat, also {formatCHF(self.annualTax, 0)} im Jahr.
      </li>
    </ul>
    <p>
      Alle Kantone nebeneinander: <a href="/quellensteuer-vergleich/">Quellensteuer-Vergleich</a>. Zu viel bezahlt?
      Tarifkorrektur und nachträgliche Veranlagung bei der Steuerverwaltung {name} laufen bis zum 31. März des
      Folgejahres — wie das geht, steht im Ratgeber
      <a href="/ratgeber/quellensteuer-oder-veranlagung/">Quellensteuer oder Veranlagung</a>.
    </p>

    <h2>Häufige Fragen</h2>
    {faqs.map((f) => (
      <div class="mb-4">
        <h3 class="mb-1 text-lg font-semibold text-slate-900">{f.q}</h3>
        <p class="text-slate-700">{f.a}</p>
      </div>
    ))}

    <p>
      Ordentliche Einkommenssteuer im Kanton {name}: <a href={`/steuerrechner/${incomeTaxSlug}/`}>Steuerrechner {name}</a>.
      Sozialabzüge auf dem Lohn: <a href="/brutto-netto-rechner/">Brutto-Netto-Rechner</a>. Alle Kantone:
      <a href="/quellensteuer-rechner/">Quellensteuer-Rechner</a>. Für Expats:
      <a href="/ratgeber/quellensteuer-expats/">Quellensteuer für Expats</a>.
    </p>
  </div>

  <div class="mt-10 max-w-2xl border-t border-slate-200 pt-4 text-sm text-slate-500">
    <p class="mb-1">
      <strong>Quellen:</strong> Quellensteuertarife {SITE_YEAR}:
      <a class="underline" href="https://www.estv.admin.ch/estv/de/home/direkte-bundessteuer/quellensteuer.html" rel="noopener">ESTV / Steuerverwaltung Kanton {name}</a>.
      Für den Inhalt der Tarife ist der Kanton zuständig. Methodik: <a class="underline" href="/methodik/">Methodik</a>.
    </p>
    <p>Zuletzt aktualisiert: 13.07.2026 · Datenstand Steuerjahr {SITE_YEAR}</p>
  </div>
</BaseLayout>
