---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { BRAND } from '../lib/site';
import { DATASETS, QST_CANTON_COUNT, formatRetrieved } from '../lib/dataRegistry';

// Sitewide sources index (SEO_SPEC §7). The dataset table below is generated
// from the _meta blocks of the shipped data files — it cannot drift from the
// numbers the calculators actually use.
const institutions = [
  {
    name: 'Eidgenössische Steuerverwaltung (ESTV) — Steuerrechner und Steuerdaten',
    url: 'https://swisstaxcalculator.estv.admin.ch/',
    use: 'Tarife, Steuerfüsse und Abzüge von Bund, Kantonen und Gemeinden',
  },
  {
    name: 'Bundesamt für Statistik (BFS) — Amtliches Gemeindeverzeichnis',
    url: 'https://www.bfs.admin.ch/bfs/de/home/grundlagen/agvch.html',
    use: 'BFS-Gemeindenummern als Ortsschlüssel',
  },
  {
    name: 'Bundesamt für Gesundheit (BAG) — Krankenversicherungsprämien',
    url: 'https://opendata.swiss/de/dataset/health-insurance-premiums',
    use: 'Genehmigte KVG-Prämien nach Versicherer, Prämienregion, Altersgruppe und Franchise',
  },
  {
    name: 'Bundesamt für Sozialversicherungen (BSV)',
    url: 'https://www.bsv.admin.ch/',
    use: 'Beitragssätze AHV/IV/EO/ALV, Kennzahlen der beruflichen Vorsorge und Säule-3a-Maximalbeträge',
  },
  {
    name: 'devbrains — swisstaxcalculator (MIT-Lizenz)',
    url: 'https://github.com/devbrains-com/swisstaxcalculator',
    use: 'Open-Source-Referenzimplementation der Steuerberechnung auf Basis der ESTV-Daten; Validierungsreferenz für unsere Berechnungslogik',
  },
];

// Localized labels for the dataset registry (ids from src/lib/dataRegistry.ts).
const LABELS: Record<string, { name: string; feeds: string }> = {
  social: {
    name: 'Sozialversicherungsbeiträge (AHV/IV/EO, ALV, NBU, BVG)',
    feeds: 'Brutto-Netto-Rechner, Stundenlohn-Rechner',
  },
  saeule3a: { name: 'Säule-3a-Maximalbeträge', feeds: 'Säule-3a-Rechner' },
  hourly: { name: 'Lohnkonstanten (Ferienentschädigung, 13. Monatslohn)', feeds: 'Stundenlohn-Rechner' },
  federal: { name: 'Tarife der direkten Bundessteuer', feeds: 'Steuervergleich, Kantonsseiten, Säule-3a-Rechner' },
  cantonal: {
    name: 'Kantonale Einkommenssteuertarife (einfache Steuer, 26 Kantone)',
    feeds: 'Steuervergleich, Kantonsseiten, Säule-3a-Rechner',
  },
  multipliers: {
    name: 'Steuerfüsse von Kantonen und Hauptorten',
    feeds: 'Steuervergleich, Kantonsseiten',
  },
  stats: {
    name: 'Gemeindesteuerfüsse: Spannweite je Kanton (alle Gemeinden)',
    feeds: 'Kantonsseiten (günstigste/teuerste Gemeinde)',
  },
  qst: {
    name: `Quellensteuertarife (${QST_CANTON_COUNT} Kantone, Tarifcodes A/B/C/H)`,
    feeds: 'Quellensteuer-Rechner, Quellensteuer-Vergleich, QST-Kantonsseiten',
  },
};
---

<BaseLayout
  title={`Quellen und Datengrundlagen | ${BRAND}`}
  description="Jeder Datensatz hinter den CalcSwiss-Rechnern mit offizieller Quelle, Abrufdatum und Steuerjahr — ESTV, BFS, BAG und BSV, einzeln nachvollziehbar."
  path="/quellen/"
>
  <Breadcrumbs crumbs={[{ name: 'Quellen' }]} />
  <article class="prose-content max-w-3xl">
    <h1 class="mb-6 text-3xl font-bold">Quellen und Datengrundlagen</h1>
    <p>
      Auf calcswiss.ch gibt es keine Zahl ohne Herkunft: Jeder Berechnungsparameter liegt in einer versionierten
      Datendatei, die ihre offizielle Quelle, das Abrufdatum und das Steuerjahr selbst dokumentiert. Die folgende
      Tabelle wird direkt aus diesen Datendateien erzeugt — sie zeigt also exakt die Datenstände, mit denen die Rechner
      auf dieser Website tatsächlich rechnen.
    </p>

    <h2>Datensätze im Einsatz</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-slate-200 text-left">
            <th class="py-2 pr-2 font-semibold">Datensatz</th>
            <th class="py-2 px-2 font-semibold">Verwendet von</th>
            <th class="py-2 px-2 text-right font-semibold">Jahr</th>
            <th class="py-2 pl-2 text-right font-semibold">Abgerufen</th>
          </tr>
        </thead>
        <tbody>
          {DATASETS.map((d) => (
            <tr class="border-b border-slate-100 align-top">
              <td class="py-2 pr-2">
                <a href={d.source} rel="noopener">{LABELS[d.id]!.name}</a>
              </td>
              <td class="py-2 px-2 text-slate-600">{LABELS[d.id]!.feeds}</td>
              <td class="py-2 px-2 text-right tabular-nums">{d.year}</td>
              <td class="py-2 pl-2 text-right tabular-nums">{formatRetrieved(d.retrieved)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="text-sm text-slate-600">
      Der Datensatzname verlinkt jeweils auf die offizielle Publikation. Die ESTV-Steuerdaten wurden über die
      MIT-lizenzierte Referenzimplementation
      <a href="https://github.com/devbrains-com/swisstaxcalculator" rel="noopener">devbrains/swisstaxcalculator</a>
      bezogen, die auf demselben offiziellen Datensatz aufbaut.
    </p>

    <h2>Herausgebende Stellen</h2>
    <ul>
      {
        institutions.map((source) => (
          <li>
            <a href={source.url} rel="noopener">
              {source.name}
            </a>
            <br />
            <span class="text-sm text-slate-600">{source.use}</span>
          </li>
        ))
      }
    </ul>

    <h2>Wie wir Daten aktualisieren</h2>
    <p>
      Die Rechner rufen zur Laufzeit <strong>keine externen Schnittstellen</strong> auf. Alle Parameter werden zum
      Build-Zeitpunkt aus den versionierten Datendateien eingebunden; Aktualisierungen erfolgen als nachvollziehbare
      Daten-Updates mit neuem Abrufdatum. Ändert eine Behörde einen Wert — etwa die Säule-3a-Maximalbeträge oder die
      Steuerfüsse eines neuen Steuerjahrs — wird die betreffende Datei erneuert und das Datum in der Tabelle oben
      springt mit. Jede Rechnerseite nennt ihren Datenstand zusätzlich im Fussbereich.
    </p>
    <p>
      Die Berechnungslogik selbst ist mit automatisierten Tests gegen publizierte offizielle Beispielwerte abgesichert;
      wie gerechnet wird, steht auf der Seite <a href="/methodik/">Methodik</a>.
    </p>
    <p>
      Die Berechnungen sind unverbindlich; massgebend ist die offizielle Veranlagung. Die ESTV, das BFS, das BAG und
      das BSV sind an dieser Website nicht beteiligt.
    </p>
  </article>
</BaseLayout>
