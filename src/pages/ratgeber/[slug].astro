---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { BRAND, SITE_URL, SITE_YEAR, absoluteUrl } from '../../lib/site';
import { formatSwissDate } from '../../lib/dates';

export async function getStaticPaths() {
  const articles = await getCollection('ratgeber');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props as { article: CollectionEntry<'ratgeber'> };
const { data } = article;
const path = `/ratgeber/${article.id}/`;
const { Content } = await render(article);

// Related articles (resolve ids → entries that actually exist).
const all = await getCollection('ratgeber');
const related = data.related
  .map((id) => all.find((a) => a.id === id))
  .filter((a): a is CollectionEntry<'ratgeber'> => Boolean(a));

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  url: absoluteUrl(path),
  inLanguage: 'de-CH',
  datePublished: data.published,
  dateModified: data.updated,
  author: { '@id': `${SITE_URL}/#organization` },
  publisher: { '@id': `${SITE_URL}/#organization` },
  mainEntityOfPage: absoluteUrl(path),
};
const faqSchema =
  data.faqs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: data.faqs.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;
const jsonLd = faqSchema ? [articleSchema, faqSchema] : [articleSchema];
---

<BaseLayout title={`${data.seoTitle ?? data.title} | ${BRAND}`} description={data.description} path={path} jsonLd={jsonLd}>
  <Breadcrumbs crumbs={[{ name: 'Ratgeber', path: '/ratgeber/' }, { name: data.title }]} />

  <article>
    <h1 class="mb-3 text-3xl font-bold tracking-tight sm:text-4xl">{data.title}</h1>
    <p class="mb-2 text-lg text-slate-700">{data.lead}</p>
    <p class="mb-8 text-xs text-slate-500">
      Veröffentlicht: {formatSwissDate(data.published)} · Aktualisiert: {formatSwissDate(data.updated)}
    </p>

    <div class="mb-8 rounded-lg border border-blue-100 bg-blue-50 p-4 text-sm">
      <span class="text-slate-700">Passend zu diesem Beitrag:</span>
      <a href={data.relatedTool.href} class="font-semibold text-blue-700 hover:underline">{data.relatedTool.label} →</a>
    </div>

    <div class="prose-content max-w-2xl">
      <Content />
    </div>

    {
      data.faqs.length > 0 && (
        <div class="prose-content mt-12 max-w-2xl">
          <h2>Häufige Fragen</h2>
          {data.faqs.map((f) => (
            <div class="mb-4">
              <h3 class="mb-1 text-lg font-semibold text-slate-900">{f.q}</h3>
              <p class="text-slate-700">{f.a}</p>
            </div>
          ))}
        </div>
      )
    }
  </article>

  {
    related.length > 0 && (
      <section aria-label="Weitere Beiträge" class="mt-14">
        <h2 class="mb-4 text-2xl font-bold">Weitere Beiträge</h2>
        <ul class="grid gap-4 sm:grid-cols-2">
          {related.map((a) => (
            <li class="rounded-lg border border-slate-200 p-5">
              <a href={`/ratgeber/${a.id}/`} class="font-semibold text-blue-700 hover:underline">
                {a.data.title}
              </a>
              <p class="mt-1 text-sm leading-relaxed text-slate-600">{a.data.description}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <div class="mt-10 max-w-2xl border-t border-slate-200 pt-4 text-sm text-slate-500">
    <p>
      Allgemeine Information, keine Steuerberatung. Methodik und Quellen:
      <a class="underline" href="/methodik/">Methodik</a> · <a class="underline" href="/quellen/">Quellen</a>. Datenstand
      Steuerjahr {SITE_YEAR}.
    </p>
  </div>
</BaseLayout>
