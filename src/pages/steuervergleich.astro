---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TaxComparison from '../components/TaxComparison.astro';
import RelatedTools from '../components/RelatedTools.astro';
import RatgeberLinks from '../components/RatgeberLinks.astro';
import { BRAND, SITE_URL, SITE_YEAR, absoluteUrl } from '../lib/site';
import { formatCHF } from '../lib/format';
import { cantonTax } from '../lib/tax/engine';

const path = '/steuervergleich/';
const title = `Steuervergleich Kantone ${SITE_YEAR} – alle 26 im Ranking | ${BRAND}`;
const description = `Ein Einkommen, alle 26 Kantone: Kantons-, Gemeinde- und Bundessteuer im direkten Vergleich der Hauptorte. Mit offiziellen ESTV-Tarifen ${SITE_YEAR}.`;

// Worked-example figures rendered server-side from the engine (single source of truth).
const zh = cantonTax(100_000, 'ZH', 'single');
const zg = cantonTax(100_000, 'ZG', 'single');

const faqs = [
  {
    q: 'Welcher Kanton hat die tiefsten Einkommenssteuern?',
    a: `Bei ${formatCHF(100000, 0)} steuerbarem Einkommen (alleinstehend) ist Zug am günstigsten, gefolgt von Schwyz und den Innerschweizer Kantonen. Das Ranking hängt aber von Einkommen und Zivilstand ab — bei anderen Werten kann sich die Reihenfolge verschieben. Der Rechner oben zeigt Ihr persönliches Ranking.`,
  },
  {
    q: 'Was bedeutet «steuerbares Einkommen»?',
    a: 'Das steuerbare Einkommen ist Ihr Einkommen nach allen Abzügen (Berufsauslagen, Versicherungsprämien, Säule 3a usw.). Es steht in Ihrer letzten Steuerveranlagung. Da die Abzüge je nach Kanton leicht unterschiedlich sind, ist der Vergleich auf Basis des steuerbaren Einkommens eine Annäherung.',
  },
  {
    q: 'Wie setzt sich die Steuerbelastung zusammen?',
    a: 'Aus drei Ebenen: der Kantonssteuer (kantonaler Tarif × kantonaler Steuerfuss), der Gemeindesteuer (Steuerfuss der Gemeinde) und der direkten Bundessteuer (einheitlicher Bundestarif). Wir rechnen mit den Steuerfüssen der Kantonshauptorte, ohne Kirchensteuer.',
  },
  {
    q: 'Warum unterscheiden sich die Kantone so stark?',
    a: `Jeder Kanton bestimmt Tarif und Steuerfuss selbst — die Bandbreite ist enorm. Beispiel bei ${formatCHF(100000, 0)} (alleinstehend): In Zug zahlen Sie total rund ${formatCHF(zg.totalTax, 0)}, in Zürich rund ${formatCHF(zh.totalTax, 0)} pro Jahr. Über ein Erwerbsleben summieren sich solche Unterschiede auf sechsstellige Beträge.`,
  },
  {
    q: 'Gilt der Vergleich auch für meine Gemeinde?',
    a: 'Der Vergleich nutzt den Steuerfuss des jeweiligen Kantonshauptorts. Ihre Gemeinde kann günstiger oder teurer sein — innerhalb eines Kantons unterscheiden sich die Gemeinden teils um mehr als 30 Steuerfuss-Prozentpunkte.',
  },
  {
    q: 'Ist die Quellensteuer berücksichtigt?',
    a: 'Nein. Dieser Vergleich gilt für ordentlich veranlagte Personen (Schweizer:innen und Ausweis C). Für quellenbesteuerte Arbeitnehmende gelten eigene Tarife.',
  },
];

const webApp = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Steuervergleich Kantone Schweiz',
  url: absoluteUrl(path),
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  inLanguage: 'de-CH',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'CHF' },
  publisher: { '@id': `${SITE_URL}/#organization` },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout title={title} description={description} path={path} jsonLd={[webApp, faqSchema]}>
  <Breadcrumbs crumbs={[{ name: 'Steuervergleich' }]} />

  <h1 class="mb-2 text-3xl font-bold tracking-tight sm:text-4xl">Steuervergleich: alle 26 Kantone {SITE_YEAR}</h1>
  <p class="mb-8 max-w-2xl text-lg text-slate-700">
    Geben Sie Ihr steuerbares Einkommen ein und sehen Sie sofort, was Sie in jedem Kantonshauptort an Kantons-,
    Gemeinde- und Bundessteuer zahlen würden — als Ranking.
  </p>

  <TaxComparison />

  <div class="prose-content mt-14 max-w-2xl">
    <h2>Warum der Wohnort über Tausende Franken entscheidet</h2>
    <p>
      Die Einkommenssteuer ist in der Schweiz zu einem grossen Teil <strong>kantonal und kommunal</strong> — und die
      Bandbreite ist enorm. Für dasselbe Einkommen zahlen Sie je nach Kanton das Doppelte oder mehr. Wer einen Umzug,
      einen Stellenwechsel in einen anderen Kanton oder den Kauf von Wohneigentum plant, trifft mit der Wohnortwahl eine
      der grössten finanziellen Entscheidungen überhaupt: Über ein Erwerbsleben summieren sich die Unterschiede auf
      sechsstellige Beträge. Der Steuervergleich macht diese Spannweite für Ihr konkretes Einkommen sichtbar — als
      Ranking aller 26 Kantonshauptorte.
    </p>

    <h2>So wird gerechnet</h2>
    <p>
      Für jeden Kanton berechnen wir die <strong>einfache Staatssteuer</strong> nach dem kantonalen Einkommenssteuertarif
      {SITE_YEAR} (Quelle: ESTV-Steuerdaten) und multiplizieren sie mit den Steuerfüssen von Kanton und Hauptort. Dazu
      kommt die <strong>direkte Bundessteuer</strong> nach Bundestarif. Kirchensteuer und Personalsteuern sind nicht
      enthalten. In Kantonen mit eigenem Gemeindetarif (Schwyz, Sitten) verwenden wir den offiziellen Gemeindetarif.
    </p>
    <p>
      Kurz als Formel: <strong>Gesamtsteuer = einfache Staatssteuer × (Steuerfuss Kanton + Steuerfuss Gemeinde) +
      direkte Bundessteuer</strong>. Die einfache Staatssteuer folgt dem progressiven Kantonstarif, der Steuerfuss ist
      ein jährlich festgelegter Multiplikator in Prozent.
    </p>
    <h2>Rechenbeispiel Schritt für Schritt</h2>
    <p>Steuerbares Einkommen {formatCHF(100000, 0)}, alleinstehend, Hauptort Zürich:</p>
    <ul>
      <li>Einfache Staatssteuer (ZH-Tarif): {formatCHF(zh.baseTax, 0)}</li>
      <li>Kantonssteuer (Steuerfuss 95%): {formatCHF(zh.cantonTax, 0)}</li>
      <li>Gemeindesteuer Stadt Zürich (119%): {formatCHF(zh.cityTax, 0)}</li>
      <li>Direkte Bundessteuer: {formatCHF(zh.federalTax, 0)}</li>
      <li><strong>Total: {formatCHF(zh.totalTax, 0)} ({(zh.effectiveRate * 100).toFixed(1)}% effektiv)</strong></li>
    </ul>
    <h2>Klug entscheiden: worauf Sie achten sollten</h2>
    <ul>
      <li>
        <strong>Die Gemeinde ist der zweite Hebel:</strong> Innerhalb eines Kantons unterscheiden sich die
        Gemeinden teils um über 30 Steuerfuss-Prozentpunkte. Wir rechnen mit dem <strong>Hauptort</strong> — in einer
        günstigen Gemeinde desselben Kantons kann die Belastung deutlich tiefer liegen.
      </li>
      <li>
        <strong>Nicht nur die Steuer zählt:</strong> Ein steuergünstiger Kanton nützt wenig, wenn Wohnkosten und
        Krankenkassenprämien den Vorteil aufzehren. Rechnen Sie die Gesamtkosten — Steuern, Miete, Prämien — gegen den
        Steuervorteil.
      </li>
      <li>
        <strong>Zivilstand verschiebt das Ranking:</strong> Verheiratete werden anders besteuert als Alleinstehende;
        was für Sie gilt, zeigt der Rechner mit dem passenden Zivilstand — mehr dazu unter
        <a href="/ratgeber/heiraten-steuern/">Heiraten &amp; Steuern</a>.
      </li>
      <li>
        <strong>Vor dem Umzug durchrechnen:</strong> Der Leitfaden
        <a href="/ratgeber/kantonswechsel-steuern-sparen/">Kantonswechsel: Steuern sparen</a> zeigt, worauf es beim
        Wohnsitzwechsel steuerlich ankommt. Steuerbares Einkommen ist Ihr Einkommen <em>nach</em> Abzügen — Ihre
        <a href="/saeule-3a-rechner/">Säule 3a</a> senkt es zusätzlich.
      </li>
    </ul>

    <h2>Häufige Fragen</h2>
    {
      faqs.map((f) => (
        <div class="mb-4">
          <h3 class="mb-1 text-lg font-semibold text-slate-900">{f.q}</h3>
          <p class="text-slate-700">{f.a}</p>
        </div>
      ))
    }
  </div>

  <RatgeberLinks ids={['kantonswechsel-steuern-sparen', 'heiraten-steuern']} />

  <RelatedTools current="steuervergleich" />

  <div class="mt-10 max-w-2xl border-t border-slate-200 pt-4 text-sm text-slate-500">
    <p class="mb-1">
      <strong>Quellen:</strong> Tarife, Steuerfüsse und Abzüge:
      <a class="underline" href="https://swisstaxcalculator.estv.admin.ch/" rel="noopener">
        ESTV Steuerrechner / Steuerdaten {SITE_YEAR}</a>. Berechnungslogik validiert gegen die
      MIT-lizenzierte Referenzimplementation
      <a class="underline" href="https://github.com/devbrains-com/swisstaxcalculator" rel="noopener">devbrains swisstaxcalculator</a>.
      Alle Quellen mit Stichdatum unter <a class="underline" href="/quellen/">Quellen</a>.
    </p>
    <p>Zuletzt aktualisiert: 12.07.2026 · Datenstand Steuerjahr {SITE_YEAR}</p>
  </div>
</BaseLayout>
