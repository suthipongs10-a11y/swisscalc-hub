---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import QstCompare from '../../components/QstCompare.astro';
import { BRAND, SITE_URL, SITE_YEAR, absoluteUrl } from '../../lib/site';
import { readFileSync } from 'node:fs';
import { formatCHF, formatPercent } from '../../lib/format';
import { compareQst, type QstvFile } from '../../lib/qst/compare';
import { frName } from '../../lib/tax/labels';

// Écart chiffré depuis les données livrées (célibataire, CHF 6'500, sans impôt ecclésiastique).
const qvRows = compareQst(6500, false, JSON.parse(readFileSync('public/data/qstv/a0.json', 'utf8')) as QstvFile);
const qvCheapest = qvRows[0]!;
const qvDearest = qvRows[qvRows.length - 1]!;

const path = '/fr/comparatif-impot-source/';
const title = `Comparatif de l’impôt à la source ${SITE_YEAR} | ${BRAND}`;
const description = `L’impôt à la source des 26 cantons comparé ${SITE_YEAR} : un salaire brut, tous les cantons — du moins cher au plus cher, avec les barèmes officiels de l’AFC.`;

const faqs = [
  {
    q: 'Pourquoi l’impôt à la source varie-t-il autant selon le canton ?',
    a: 'Les barèmes de l’impôt à la source intègrent l’impôt cantonal, communal et fédéral du canton concerné. Comme les taux cantonaux varient fortement, l’impôt à la source pour un même salaire diffère considérablement — le comparatif montre l’étendue en un coup d’oeil.',
  },
  {
    q: 'Puis-je réduire mon impôt à la source en déménageant ?',
    a: 'Oui — c’est en principe le canton de domicile qui est déterminant (pour les frontaliers, le canton de travail). Un déménagement dans un canton moins cher réduit l’impôt à la source en conséquence. Tenez toutefois compte des loyers et des primes d’assurance-maladie, qui peuvent absorber l’avantage fiscal.',
  },
  {
    q: 'Que signifie l’astérisque (modèle annuel) dans le tableau ?',
    a: 'Fribourg, Genève, le Tessin, Vaud et le Valais appliquent le modèle annuel : le salaire est annualisé et lissé pour déterminer le taux. Avec un salaire mensuel régulier, le résultat est comparable au modèle mensuel ; avec des bonus ou salaires irréguliers, le décompte annuel effectif peut différer.',
  },
  {
    q: 'Le comparatif vaut-il aussi pour les frontaliers ?',
    a: 'Seulement en partie. Pour les frontaliers d’Allemagne, un taux réduit de 4.5% au maximum s’applique (CDI) ; huit cantons ont un accord particulier avec la France, et des barèmes spécifiques existent pour l’Italie. Le comparatif montre les barèmes ordinaires A/B/C/H pour les personnes domiciliées en Suisse.',
  },
];

const webApp = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Comparatif de l’impôt à la source',
  url: absoluteUrl(path),
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  inLanguage: 'fr-CH',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'CHF' },
  publisher: { '@id': `${SITE_URL}/#organization` },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout title={title} description={description} path={path} locale="fr" hero="comparison" jsonLd={[webApp, faqSchema]}>
  <Breadcrumbs
    crumbs={[{ name: 'Impôt à la source', path: '/fr/calculateur-impot-source/' }, { name: 'Comparatif des cantons' }]}
    locale="fr"
  />

  <h1 class="mb-2 text-3xl font-bold tracking-tight sm:text-4xl">Comparatif de l’impôt à la source {SITE_YEAR}</h1>
  <p class="mb-8 max-w-2xl text-lg text-slate-700">
    Un salaire brut, les 26 cantons : voyez en un coup d’oeil où l’impôt à la source est le plus bas et où il est le
    plus élevé — avec les barèmes officiels de l’AFC {SITE_YEAR}.
  </p>

  <QstCompare locale="fr" />

  <div class="prose-content mt-14 max-w-2xl">
    <h2>Pourquoi le comparatif cantonal en vaut la peine</h2>
    <p>
      Les barèmes de l’impôt à la source regroupent impôt cantonal, communal et fédéral — et comme les taux cantonaux
      sont très éloignés, une personne imposée à la source paie, pour le même salaire, très différemment selon le canton
      de domicile. Qui accepte un poste en Suisse et peut encore choisir librement son domicile, ou qui envisage un
      déménagement, prend ici une décision aux effets sensibles sur le budget mensuel. Le comparatif place les 26
      cantons côte à côte pour votre salaire — du moins cher au plus cher.
    </p>

    <h2>Comment fonctionne le comparatif ?</h2>
    <p>
      Pour chaque canton, le même salaire mensuel brut est calculé avec le barème officiel {SITE_YEAR} du canton — selon
      le barème correspondant à votre situation (A/B/C/H, nombre d’enfants, impôt ecclésiastique). Le tableau classe
      les cantons du moins cher au plus cher. Un clic sur le canton ouvre sa page d’impôt à la source avec les détails
      et son propre calculateur.
    </p>
    <p>
      Pour chaque canton, la même formule que dans le calculateur individuel : <strong>impôt à la source = max(salaire
      brut × taux, impôt minimal)</strong>, avec le taux et l’impôt minimal de l’échelon du canton concerné, arrondi à
      5 centimes. Les différences entre cantons viennent donc uniquement des barèmes — pas de la méthode.
    </p>
    <h2>Exemple de calcul étape par étape</h2>
    <p>
      Célibataire, sans enfant, sans impôt ecclésiastique (barème A0N), {formatCHF(6500, 0)} de salaire brut par mois :
    </p>
    <ul>
      <li>Canton le moins cher : <strong>{frName(qvCheapest.abbr)}</strong> avec {formatCHF(qvCheapest.monthlyTax)} par mois ({formatPercent(qvCheapest.ratePct / 100)})</li>
      <li>Canton le plus cher : <strong>{frName(qvDearest.abbr)}</strong> avec {formatCHF(qvDearest.monthlyTax)} par mois ({formatPercent(qvDearest.ratePct / 100)})</li>
      <li><strong>Écart : {formatCHF(qvDearest.monthlyTax - qvCheapest.monthlyTax)} par mois</strong> — soit environ {formatCHF((qvDearest.monthlyTax - qvCheapest.monthlyTax) * 12, 0)} par an pour le même salaire</li>
    </ul>

    <h2>Décider intelligemment : à quoi faire attention</h2>
    <ul>
      <li>
        <strong>L’impôt n’est pas tout :</strong> un canton avantageux sert peu si loyer et primes d’assurance-maladie
        absorbent le gain — calculez les coûts totaux.
      </li>
      <li>
        <strong>Attention à l’impôt ecclésiastique :</strong> à Genève, Neuchâtel, au Tessin, dans le canton de Vaud et
        en Valais, il n’est <strong>pas prélevé à la source</strong> ; dans le Jura, il est toujours inclus — l’option
        n’agit que dans les autres cantons.
      </li>
      <li>
        <strong>Modèle annuel (astérisque) :</strong> Fribourg, Genève, le Tessin, Vaud et le Valais lissent le salaire
        sur l’année — avec des bonus ou salaires irréguliers, le décompte annuel effectif peut différer.
      </li>
      <li>
        <strong>Détails par canton :</strong> un clic sur le canton ouvre sa
        <a href="/fr/calculateur-impot-source/">page d’impôt à la source</a> avec son propre calculateur. Les barèmes
        frontaliers (DE/FR/IT) ne sont pas reproduits ; les taux sont agrégés à 0,05 point (indicatif). Imposé
        ordinairement ? <a href="/fr/comparatif-impots-cantons/">comparatif des 26 cantons</a>.
      </li>
    </ul>

    <h2>Questions fréquentes</h2>
    {faqs.map((f) => (
      <div class="mb-4">
        <h3 class="mb-1 text-lg font-semibold text-slate-900">{f.q}</h3>
        <p class="text-slate-700">{f.a}</p>
      </div>
    ))}
  </div>

  <section aria-label="Autres calculateurs" class="mt-14">
    <h2 class="mb-4 text-2xl font-bold">Autres calculateurs</h2>
    <ul class="grid gap-4 sm:grid-cols-2">
      <li class="rounded-lg border border-slate-200 p-5">
        <a href="/fr/calculateur-impot-source/" class="font-semibold text-blue-700 hover:underline">Calculateur d’impôt à la source</a>
        <p class="mt-1 text-sm leading-relaxed text-slate-600">Par canton, barème et situation familiale.</p>
      </li>
      <li class="rounded-lg border border-slate-200 p-5">
        <a href="/fr/comparatif-impots-cantons/" class="font-semibold text-blue-700 hover:underline">Comparatif des impôts des 26 cantons</a>
        <p class="mt-1 text-sm leading-relaxed text-slate-600">Pour les personnes imposées ordinairement.</p>
      </li>
    </ul>
  </section>

  <div class="mt-10 max-w-2xl border-t border-slate-200 pt-4 text-sm text-slate-500">
    <p class="mb-1">
      <strong>Sources :</strong> barèmes de l’impôt à la source {SITE_YEAR} des cantons :
      <a class="underline" href="https://www.estv.admin.ch/estv/fr/accueil/impot-federal-direct/impot-a-la-source.html" rel="noopener">AFC / administrations fiscales cantonales</a>.
      Le contenu des barèmes relève des cantons. Méthodologie et limites :
      <a class="underline" href="/fr/methodologie/">méthodologie</a>.
    </p>
    <p>Dernière mise à jour : 15.07.2026 · année fiscale {SITE_YEAR}</p>
  </div>
</BaseLayout>
