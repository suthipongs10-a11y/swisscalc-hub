---
/**
 * Homepage hub (SEO_SPEC §2). Tool cards are unlinked until the tools ship —
 * no broken/orphan links, ever. Cards become links milestone by milestone.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../lib/i18n';
import { BRAND, SITE_URL, SITE_YEAR } from '../lib/site';

const t = useTranslations('de');

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: BRAND,
  url: `${SITE_URL}/`,
  inLanguage: 'de-CH',
  publisher: { '@id': `${SITE_URL}/#organization` },
};

const tools = [
  {
    name: `Brutto-Netto-Rechner Schweiz ${SITE_YEAR}`,
    description: 'Vom Bruttolohn zum Nettolohn: AHV, IV, EO, ALV, NBU, BVG — transparent aufgeschlüsselt.',
  },
  {
    name: 'Quellensteuer-Rechner',
    description: 'Quellensteuer für ausländische Arbeitnehmende — nach Kanton, Tarifcode und Gemeinde.',
  },
  {
    name: 'Steuervergleich aller 26 Kantone',
    description: 'Ein Einkommen, alle Kantone: wo zahlen Sie wie viel Einkommenssteuer?',
  },
  {
    name: 'Säule-3a-Rechner',
    description: 'Wie viel Steuern spart Ihre Einzahlung in die Säule 3a? Nach Kanton und Einkommen.',
  },
  {
    name: 'Franchise-Rechner Krankenkasse',
    description: 'Welche Franchise lohnt sich bei Ihren Gesundheitskosten? Break-even einfach berechnet.',
  },
];
---

<BaseLayout
  title={`${t('home.title')} ${SITE_YEAR} | ${BRAND}`}
  description={t('home.metaDescription')}
  path="/"
  jsonLd={[websiteJsonLd]}
>
  <h1 class="mb-4 text-3xl font-bold tracking-tight sm:text-4xl">{t('home.h1')}</h1>
  <p class="mb-10 max-w-2xl text-lg leading-relaxed text-slate-700">{t('home.intro')}</p>

  <h2 class="mb-4 text-2xl font-bold">{t('home.toolsHeading')}</h2>
  <ul class="grid gap-4 sm:grid-cols-2">
    {
      tools.map((tool) => (
        <li class="rounded-lg border border-slate-200 p-5">
          <div class="mb-1 flex items-start justify-between gap-2">
            <h3 class="font-semibold text-slate-900">{tool.name}</h3>
            <span class="shrink-0 rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800">
              {t('home.comingSoon')}
            </span>
          </div>
          <p class="text-sm leading-relaxed text-slate-600">{tool.description}</p>
        </li>
      ))
    }
  </ul>

  <section class="prose-content mt-12 max-w-2xl">
    <h2>Warum CalcSwiss?</h2>
    <p>
      Jede Zahl auf dieser Website stammt aus einer offiziellen Quelle — ESTV, BFS, BAG oder den kantonalen
      Steuerverwaltungen — und ist mit Quellenangabe und Stichdatum hinterlegt. Wie gerechnet wird, legen wir auf der
      Seite <a href="/methodik/">Methodik</a> offen. Ohne Werbung, ohne Cookies, ohne Anmeldung.
    </p>
  </section>
</BaseLayout>
