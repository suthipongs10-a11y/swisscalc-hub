---
/**
 * Base layout: semantic HTML, locale-aware lang + hreflang (SEO_SPEC §2/§6),
 * system font stack (no web fonts — CLAUDE.md performance budget).
 */
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroArt from '../components/HeroArt.astro';
import { LOCALE_LANG, alternatesFor, type Locale } from '../lib/locales';
import { resolveHeroVariant, type HeroVariant } from '../lib/hero';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: object[];
  locale?: Locale;
  /** Override the path-derived hero illustration; `null` hides it entirely. */
  hero?: HeroVariant | null;
  /** Canton abbreviation printed on the canton/withholding-canton illustrations. */
  heroLabel?: string;
}

const { title, description, path, jsonLd, locale = 'de', hero, heroLabel } = Astro.props;
const alternates = alternatesFor(path);
const heroVariant = hero === null ? null : (hero ?? resolveHeroVariant(path));
---

<!doctype html>
<html lang={LOCALE_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO title={title} description={description} path={path} jsonLd={jsonLd} locale={locale} alternates={alternates} />
  </head>
  <body class="min-h-screen bg-white font-sans text-slate-900 antialiased">
    <Header locale={locale} path={path} />
    <main class="mx-auto max-w-4xl px-4 py-8">
      {heroVariant && <HeroArt variant={heroVariant} label={heroLabel} />}
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
